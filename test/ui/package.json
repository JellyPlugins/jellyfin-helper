{
  "name": "jellyfin-helper-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Vitest suite for the Jellyfin Helper config page scripts and discovery sidebar (runs against the real shipped sources).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/test-coverage.mjs",
    "coverage:check": "node scripts/check-coverage.mjs --lines=85 --branches=80"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
